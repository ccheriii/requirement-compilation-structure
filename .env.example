# Copy to .env; use a model that accepts image input.
MODEL=deepseek-flash
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.arc-bench.com/v1
# All stages use low reasoning, including implementation, repairs and image analysis.
# auto is an alias for low. provider requests no reasoning override.
MODEL_REASONING=low
VISUAL_REASONING=low
# Text response budget includes both reasoning and final output tokens.
MAX_OUTPUT_TOKENS=320000
# Concurrent reference-image analyses in stage 01 (default 4).
VISUAL_CONCURRENCY=4
# Pre-supply files that earlier tasks of the same kind had to read (saves read round trips).
# Set to 0 to disable.
ARC_READ_AHEAD=1
# Run stage 07 alongside 06 and 09 alongside 08 in full-pipeline runs. Set to 0 to disable.
ARC_OVERLAP_STAGES=1
# Concurrent independent-acceptance test generation in stage 10 (1 = sequential).
ARC_ACCEPTANCE_CONCURRENCY=4
# Concurrent functional smoke-test writing at the start of stage 10 (1 = sequential).
ARC_E2E_TEST_CONCURRENCY=4
# Concurrent obligation inference in stage 03 (1 = sequential).
ARC_DESIGN_CONCURRENCY=4
# Concurrent API contract-test writing at the start of stage 06 (1 = sequential).
ARC_BACKEND_TEST_CONCURRENCY=4
# Per-task reasoning: MODEL_REASONING_TESTS / _DESIGN / _IMPLEMENTATION override
# MODEL_REASONING for that kind of task (none, low, high, max, provider, auto).
# MODEL_REASONING_TESTS=none
# Stall detection: requests that produce no output within this many seconds are
# cancelled and resent (healthy requests start in ~2-4 s). ARC_STREAM=0 disables.
ARC_STALL_FIRST_CHUNK_SECONDS=10
ARC_STALL_RETRIES=5
# Stall deadline for requests with images (they start answering later than text).
ARC_STALL_FIRST_CHUNK_SECONDS_VISION=60
